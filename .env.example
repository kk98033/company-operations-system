# Local development only. Copy to .env and replace local-only values.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_ORIGIN=http://127.0.0.1:5173
CSRF_HMAC_KEY=replace-with-token-urlsafe-32-byte-value

POSTGRES_DB=company_system_dev
POSTGRES_USER=company_system_dev
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Isolated, disposable database used only by explicit integration checks.
POSTGRES_TEST_DB=company_system_test
POSTGRES_TEST_USER=company_system_test
POSTGRES_TEST_PASSWORD=company-system-test-only
POSTGRES_TEST_PORT=5433

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# API origin only; paths generated from OpenAPI already contain /api/v1.
# Keep empty for the local Vite same-origin proxy.
VITE_API_ORIGIN=
