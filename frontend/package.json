{
  "name": "company-system-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "api:generate": "../scripts/generate-api-client.sh",
    "api:check": "../scripts/generate-api-client.sh --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && node scripts/check-ui-conformance.mjs",
    "check:ui": "node scripts/check-ui-conformance.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/Accessibility.test.tsx",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.11",
    "@tanstack/react-router": "1.170.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "orval": "8.24.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
