                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "輸入資料驗證失敗"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "伺服器發生未預期錯誤"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "載入目前使用者與公司 Session",
        "tags": [
          "auth"
        ]
      }
    },
