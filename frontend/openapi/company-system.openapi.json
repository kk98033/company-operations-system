{
  "components": {
    "schemas": {
      "AuthenticatedOrganizationResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "AuthenticatedOrganizationResponse",
        "type": "object"
      },
      "AuthenticatedUserResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "login_name": {
            "title": "Login Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "login_name",
          "display_name"
        ],
        "title": "AuthenticatedUserResponse",
        "type": "object"
      },
      "CurrentSessionResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/AuthenticatedOrganizationResponse"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserResponse"
          }
        },
        "required": [
          "expires_at",
          "user",
          "organization"
        ],
        "title": "CurrentSessionResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Stable, machine-readable API error fields.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Public JSON envelope for every handled API error.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "service": {
            "const": "company-system-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "login_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Login Name",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "login_name",
          "password",
          "organization_id"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/AuthenticatedOrganizationResponse"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserResponse"
          }
        },
        "required": [
          "expires_at",
          "user",
          "organization"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "ReadinessCheckResult": {
        "description": "One necessary dependency's current readiness state.",
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ReadinessCheckResult",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "in": "cookie",
        "name": "company_system_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "公司內部報價、工單、生產、出貨與帳務系統 API。",
    "title": "公司管理系統 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "請求格式錯誤"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "尚未通過身分驗證"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "沒有執行此操作的權限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "資源不存在"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "HTTP method 不允許用於此資源"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "資料狀態或版本衝突"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "輸入資料驗證失敗"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "伺服器發生未預期錯誤"
          }
        },
        "summary": "以使用者代號建立伺服器登入 Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          },
          {
            "in": "cookie",
            "name": "company_system_csrf",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Company System Csrf"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
